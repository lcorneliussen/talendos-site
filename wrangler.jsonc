{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talendos-site",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-26",
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "info@talendos.com",
      "allowed_sender_addresses": ["website@talendos.com"],
    },
  ],
  "vars": {
    "CONTACT_TO": "info@talendos.com",
    "CONTACT_FROM": "website@talendos.com",
  },
}
