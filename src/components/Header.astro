---
import { sitePath } from "../lib/sitePath";

const nav = [
  { href: sitePath("#approach"), label: "Approach" },
  { href: sitePath("#expertise"), label: "Expertise" },
  { href: sitePath("contact/"), label: "Contact" },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={sitePath()} aria-label="Talendos home">
      <img
        class="mark"
        src={sitePath("brand/talendos-symbol-original.png")}
        alt=""
        width="38"
        height="40"
      />
      <img
        class="wordmark"
        src={sitePath("brand/talendos-wordmark-dark.png")}
        alt="Talendos"
        width="164"
        height="40"
      />
    </a>
    <nav aria-label="Main navigation">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="button header-cta" href={sitePath("contact/")}>Contact</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgb(217 228 234 / 80%);
    background: rgb(255 255 255 / 92%);
    backdrop-filter: blur(14px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.8rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-right: auto;
    font-weight: 800;
    text-decoration: none;
  }
  .mark {
    width: 2.35rem;
    height: auto;
  }
  .wordmark {
    width: 9.4rem;
    height: auto;
  }
  nav {
    display: flex;
    gap: 1.5rem;
  }
  nav a {
    color: var(--slate);
    font-size: 0.94rem;
    font-weight: 700;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--blue-dark);
  }
  .header-cta {
    min-height: 2.65rem;
  }
  @media (max-width: 760px) {
    .bar {
      gap: 0.75rem;
      min-height: 4.3rem;
    }
    nav {
      display: none;
    }
    .header-cta {
      padding-inline: 0.85rem;
      font-size: 0.88rem;
    }
  }
  @media (max-width: 420px) {
    .wordmark {
      width: 7.4rem;
    }
  }
</style>
