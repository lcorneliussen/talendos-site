---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact – Talendos"
  description="Contact Talendos directly by email or phone."
>
  <section class="contact-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>What could we build together?</h1>
      <p class="lead">Reach us directly by email or phone.</p>
    </div>
  </section>
  <section class="section">
    <div class="container contact-grid">
      <article>
        <p class="eyebrow">By email</p>
        <h2>Start a conversation</h2>
        <p>The link opens a new message in your preferred email application.</p>
        <a
          class="button"
          href="mailto:info@talendos.com?subject=Enquiry%20via%20talendos.com"
          >Email info@talendos.com</a
        >
      </article>
      <aside>
        <p class="eyebrow">Direct contact</p>
        <h2>Talendos GmbH</h2>
        <address>Richtstrecke 16a<br />45731 Waltrop<br />Germany</address>
        <div>
          <a href="mailto:info@talendos.com">info@talendos.com</a><br />
          <a href="tel:+4923099690200">+49 2309 9690200</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding-block: clamp(5rem, 11vw, 8rem);
    background: var(--blue-pale);
  }
  .contact-hero .container,
  article,
  aside {
    display: grid;
    gap: 1.2rem;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 7vw, 6rem);
  }
  article,
  aside {
    align-content: start;
  }
  article .button {
    justify-self: start;
  }
  aside {
    padding: 2rem;
    border-radius: var(--radius);
    background: var(--mist);
  }
  address {
    color: var(--ink-soft);
    font-style: normal;
  }
  aside a {
    text-underline-offset: 0.2em;
  }
  @media (max-width: 740px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
